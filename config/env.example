# OpenCortex local development example.
# Runtime secrets belong in podman secrets on the deployment host.

OPENCORTEX_PUBLIC_BASE_URL=http://localhost:8080
OPENCORTEX_OIDC_ISSUER=http://localhost:5556/dex
OPENCORTEX_OIDC_CLIENT_ID=opencortex-runtime
OPENCORTEX_OIDC_CLI_CLIENT_ID=opencortex-cli
OPENCORTEX_OIDC_SCOPES=openid,email,profile,groups
OPENCORTEX_REQUIRED_GROUPS=CortexUsers
OPENCORTEX_INTERNAL_TOKEN_SECRET=change-me-local-only-32-byte-secret
OPENCORTEX_WORKSPACE_ROOT=/srv/opencortex/workspaces
OPENCORTEX_MEMORY_DATABASE_URL=postgres://opencortex:opencortex@localhost:5432/opencortex_memory
OPENCORTEX_MEMORY_API_URL=http://opencortex-memory-api:3000
OPENCORTEX_MEMORY_JWT_SECRET=change-me-local-only
OPENCORTEX_TEMPORAL_ADDRESS=localhost:7233
OPENCORTEX_EMBEDDINGS_URL=http://localhost:7997/v1/embeddings
OPENCORTEX_EMBEDDINGS_MODEL=nomic-ai/nomic-embed-text-v1.5
OPENCORTEX_EMBEDDINGS_DIMENSIONS=768
OPENCORTEX_OBJECTS_ENDPOINT=http://localhost:8333
OPENCORTEX_OBJECTS_BUCKET=opencortex-artifacts
OPENCORTEX_SKILLS_DIR=/opt/opencortex/skills/skills
OPENCORTEX_SKILLS_STAGING_DIR=/opt/opencortex/skills
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=opencortex-orchestrator
