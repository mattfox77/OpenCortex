[Unit]
Description=OpenCortex bundled Dex OIDC issuer
After=opencortex-network-network.service
Wants=opencortex-network-network.service

[Container]
Image=ghcr.io/dexidp/dex:latest
ContainerName=opencortex-dex
Network=opencortex.network
PublishPort=127.0.0.1:5556:5556
Volume=%h/.config/opencortex/dex.yaml:/etc/dex/config.yaml:ro,Z
Volume=opencortex-dex.volume:/var/dex:Z
Secret=opencortex_dex_client_secret,type=env,target=OPENCORTEX_DEX_CLIENT_SECRET
Exec=serve /etc/dex/config.yaml

[Service]
Restart=on-failure
ExecStartPost=/usr/bin/bash -lc 'for i in {1..60}; do timeout 2 bash -c "</dev/tcp/127.0.0.1/5556" && exit 0; sleep 1; done; exit 1'

[Install]
WantedBy=default.target
