[Unit]
Description=OpenCortex Temporal server
After=opencortex-memory-db.service
Requires=opencortex-memory-db.service

[Container]
ContainerName=opencortex-temporal
Image=docker.io/temporalio/auto-setup:1.25
Network=opencortex.network
Environment=DB=postgres12
Environment=DBNAME=opencortex_temporal
Environment=VISIBILITY_DBNAME=opencortex_temporal_visibility
Environment=DB_PORT=5432
Environment=POSTGRES_SEEDS=opencortex-memory-db
Environment=POSTGRES_USER=opencortex
Secret=opencortex_postgres_password,type=env,target=POSTGRES_PWD
Environment=DYNAMIC_CONFIG_FILE_PATH=config/dynamicconfig/development-sql.yaml
PublishPort=127.0.0.1:7233:7233

[Service]
Restart=always
ExecStartPost=/usr/bin/bash -lc 'for i in {1..60}; do timeout 2 bash -c "</dev/tcp/127.0.0.1/7233" && exit 0; sleep 1; done; exit 1'

[Install]
WantedBy=default.target
