{
  "name": "opencortex",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI engineering control plane",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/runtime",
    "packages/memory",
    "packages/workbench",
    "packages/activity-ledger",
    "packages/skills",
    "packages/ui"
  ],
  "scripts": {
    "build": "npm --prefix packages/orchestrator run build && npm --prefix packages/workbench run build && npm --prefix packages/skills run build && npm --prefix packages/runtime run build",
    "check": "npm --prefix packages/orchestrator run check && npm --prefix packages/workbench run check && npm --prefix packages/skills run check && npm --prefix packages/runtime run check && npm --prefix packages/memory run check && node scripts/config-inventory.mjs",
    "memory:check": "npm --prefix packages/memory run check",
    "memory:migrate": "npm --prefix packages/memory run migrate",
    "runtime:check": "npm --prefix packages/runtime run check",
    "runtime:test": "npm --prefix packages/runtime test",
    "skills:check": "npm --prefix packages/skills run check",
    "workbench:check": "npm --prefix packages/workbench run check",
    "config:inventory": "node scripts/config-inventory.mjs",
    "orchestrator:worker": "npm --prefix packages/orchestrator run worker",
    "orchestrator:task": "npm --prefix packages/orchestrator run task",
    "orchestrator:monitor": "npm --prefix packages/orchestrator run monitor"
  },
  "keywords": [
    "opencortex",
    "temporal",
    "ai-agents",
    "control-plane",
    "self-hosted"
  ],
  "license": "MIT"
}
