#!/usr/bin/env bash
# OpenCortex Memory compatibility shim.
#
# The Phase 7 CLI surface is `cortex`. This script keeps old `brain` calls
# from failing abruptly, migrates the legacy config location once, prints a
# notice, and delegates supported commands to `cortex`.
set -euo pipefail

BRAIN_SHIM_VERSION="2.0.0"
OPENCORTEX_MEMORY_DIR="${OPENCORTEX_MEMORY_CONFIG_DIR:-${HOME}/.opencortex/memory}"
OPENCORTEX_MEMORY_CONFIG="${OPENCORTEX_MEMORY_CONFIG:-${OPENCORTEX_MEMORY_DIR}/config}"
LEGACY_BRAINTRUST_DIR="${BRAINTRUST_CONFIG_DIR:-${HOME}/.braintrust}"
LEGACY_BRAINTRUST_CONFIG="${BRAINTRUST_CONFIG:-${LEGACY_BRAINTRUST_DIR}/config}"

notice() {
  echo "brain is deprecated; use cortex. Delegating this command to cortex." >&2
}

migrate_config() {
  if [ -f "$OPENCORTEX_MEMORY_CONFIG" ]; then
    return 0
  fi
  if [ ! -f "$LEGACY_BRAINTRUST_CONFIG" ]; then
    return 0
  fi
  mkdir -p "$OPENCORTEX_MEMORY_DIR"
  cp "$LEGACY_BRAINTRUST_CONFIG" "$OPENCORTEX_MEMORY_CONFIG"
  chmod 600 "$OPENCORTEX_MEMORY_CONFIG" 2>/dev/null || true
  echo "Migrated ${LEGACY_BRAINTRUST_CONFIG} to ${OPENCORTEX_MEMORY_CONFIG}." >&2
}

require_cortex() {
  if command -v cortex >/dev/null 2>&1; then
    return 0
  fi
  echo "brain compatibility shim requires the cortex CLI on PATH." >&2
  exit 127
}

delegate() {
  migrate_config
  notice
  require_cortex
  exec cortex "$@"
}

delegate_stdin() {
  local content
  content="$(cat)"
  migrate_config
  notice
  require_cortex
  printf '%s' "$content" | cortex "$@"
}

usage() {
  cat >&2 <<'H'
brain is now an OpenCortex compatibility shim.

Use:
  cortex login
  cortex memory capture "text"|-
  cortex memory search "query"
  cortex memory recall "query"
  cortex memory sync run --source opencode (--file PATH|-)
  cortex session list
  cortex workflow list
  cortex activity report

Supported brain aliases:
  brain search|recall|capture ...
  brain sync run ...
  brain ingest FILE [-t title] [-p project]
  <transcript> | brain archive full|rescue [-p project] [-s session]
  <text> | brain learn "title" [project]
H
}

case "${1:-help}" in
  version|--version|-v)
    echo "brain compatibility shim ${BRAIN_SHIM_VERSION}"
    ;;
  help|-h|--help)
    usage
    ;;
  search)
    shift
    delegate memory search "$@"
    ;;
  recall)
    shift
    delegate memory recall "$@"
    ;;
  capture)
    shift
    delegate memory capture "$@"
    ;;
  sync)
    shift
    delegate memory sync "$@"
    ;;
  ingest)
    shift
    file="${1:-}"
    [ -n "$file" ] || { echo "Usage: brain ingest FILE [-t title] [-p project]" >&2; exit 2; }
    shift
    delegate memory sync run --source brain-ingest --file "$file" "$@"
    ;;
  archive)
    shift
    mode="${1:-full}"
    [ $# -gt 0 ] && shift
    scope="personal"
    case "$mode" in
      full) scope="personal" ;;
      rescue) scope="team" ;;
      auto) scope="personal" ;;
      *)
        echo "Usage: brain archive full|rescue|auto [-p project] [-s session]" >&2
        exit 2
        ;;
    esac
    args=(memory sync run --source brain-archive - --title "brain archive ${mode}" --scope "$scope")
    while [ $# -gt 0 ]; do
      case "$1" in
        -p|--project)
          args+=("--project" "${2:-}")
          shift 2
          ;;
        -s|--session|--session-id)
          args+=("--session-id" "${2:-}")
          shift 2
          ;;
        *)
          echo "unknown brain archive option: $1" >&2
          exit 2
          ;;
      esac
    done
    delegate_stdin "${args[@]}"
    ;;
  learn)
    shift
    title="${1:-brain learn}"
    [ $# -gt 0 ] && shift
    args=(memory capture - --title "$title" --scope team --kind document --source-system brain-learn)
    if [ $# -gt 0 ] && [[ "${1:-}" != --* ]]; then
      args+=("--project" "$1")
      shift
    fi
    delegate_stdin "${args[@]}" "$@"
    ;;
  *)
    migrate_config
    notice
    echo "brain ${1:-help} is no longer supported by the compatibility shim." >&2
    echo "Run 'cortex --help' or 'brain help' for supported commands." >&2
    exit 2
    ;;
esac
