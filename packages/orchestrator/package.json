{
  "name": "@opencortex/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Temporal workflows, activities, and worker runtime for OpenCortex",
  "main": "src/worker.ts",
  "scripts": {
    "worker": "ts-node src/worker.ts",
    "task": "ts-node scripts/start-task.ts",
    "monitor": "ts-node scripts/start-task.ts --monitor",
    "ingest": "ts-node scripts/ingest-memory.ts",
    "provision-user": "ts-node scripts/provision-user.ts",
    "activity-rollup": "ts-node scripts/activity-rollup.ts",
    "rebuild-projection": "ts-node scripts/rebuild-projection.ts",
    "test:replay": "ts-node scripts/replay-memory-ingest.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.21.1",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
