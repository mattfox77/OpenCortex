# Google OIDC via a web OAuth client.
# Replace the client values with credentials from Google Cloud.

OPENCORTEX_PUBLIC_BASE_URL=https://linux-macbook.tail5861c6.ts.net
OPENCORTEX_OIDC_ISSUER=https://accounts.google.com
OPENCORTEX_OIDC_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
OPENCORTEX_OIDC_CLIENT_SECRET=replace-with-google-web-client-secret
OPENCORTEX_OIDC_SCOPES=openid,email,profile

# Google ID tokens normally do not include a groups claim. Leave group gating
# disabled for direct Google OIDC unless a separate issuer maps groups.
OPENCORTEX_REQUIRED_GROUPS=

# Optional email-domain gate for local/test deployments.
OPENCORTEX_ALLOWED_EMAIL_DOMAINS=
